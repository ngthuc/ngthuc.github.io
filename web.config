<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <location path="images">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="15.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="fonts">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="15.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>